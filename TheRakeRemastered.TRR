-- === Rayfield + Aba Exploits completa (inclui Rayfield GUI e Insta Open SupplyDrop em loop) ===

-- Carrega Rayfield (igual ao original)
local Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/ltseverydayyou/Rayfield-backup/main/Rayfield'))()

-- Cria janela (ajuste o nome/ícone se quiser)
local Window = Rayfield:CreateWindow({
	Name = "Chefin GUI [The Rake]",
	LoadingTitle = "Chefin GUI [The Rake]",
	LoadingSubtitle = "Chefinho Hub",
	ConfigurationSaving = {
		Enabled = true,
		FolderName = "ProjectTheRake",
		FileName = "Project"
	}
})

-- Garante que variáveis/serviços base existam (se já existirem no seu script, tudo bem)
local ClonedService = ClonedService or function(n) return game:GetService(n) end
local AllowRunService = AllowRunService == nil and true or AllowRunService
-- NOTE: getHum(), GET_HRP(), SET_HRP_CFRAME(), HidePart, HidePartHightLight assumed definidos globalmente

-- Cria Aba Exploits
local ExploitsTab = Window:CreateTab("Exploits", 11252440817)

-- Rake Killaura Toggle
local RakeKillauraToggle = ExploitsTab:CreateToggle({
	Name = "Rake Killaura",
	CurrentValue = false,
	Flag = "RakeAura",
	Callback = function(state)
		_G.RakeKillAura = state
		Rayfield:Notify({
			Title = "Rake Killaura",
			Content = "Rake Killaura : "..tostring(_G.RakeKillAura),
			Duration = 1,
			Image = 4483362458,
		})
		if _G.RakeKillAura == true then
			spawn(function()
				repeat wait()
					pcall(function()
						if ClonedService("Workspace"):FindFirstChild("Rake") then
							local rake = ClonedService("Workspace").Rake
							local plr = ClonedService("Players").LocalPlayer
							if rake and plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
								local dist = (rake.HumanoidRootPart.Position - plr.Character.HumanoidRootPart.Position).Magnitude
								if dist < 200 then
									-- envia eventos iguais ao original para bater
									pcall(function() plr.Character.StunStick.Event:FireServer("S") end)
									wait()
									pcall(function() plr.Character.StunStick.Event:FireServer("H", rake.HumanoidRootPart) end)
								end
							end
						end
					end)
				until _G.RakeKillAura == false
			end)
		end
	end,
})

-- Toggle Killaura Keybind (R)
ExploitsTab:CreateKeybind({
	Name = "Toggle Killaura",
	CurrentKeybind = "R",
	HoldToInteract = false,
	Flag = "KillAuraKeybind",
	Callback = function()
		if _G.RakeKillAura == true then
			RakeKillauraToggle:Set(false)
		else
			RakeKillauraToggle:Set(true)
		end
	end,
})

-- Bring Scraps Button
ExploitsTab:CreateButton({
	Name = "Bring Scraps",
	Callback = function()
		pcall(function()
			for _,v in pairs(ClonedService("Workspace").Filter.ScrapSpawns:GetDescendants()) do
				if typeof(v.Name) == "string" and v.Name:lower() == "scrap" then
					if v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("Part") then
						pcall(function() v:PivotTo(ClonedService("Players").LocalPlayer.Character:GetPivot()) end)
					end
				end
			end
		end)
	end,
})

-- Remove Invisible Walls Button
ExploitsTab:CreateButton({
	Name = "Remove Invis Walls",
	Callback = function()
		pcall(function()
			if ClonedService("Workspace"):FindFirstChild("Filter") and ClonedService("Workspace").Filter:FindFirstChild("InvisibleWalls") then
				for i,v in pairs(ClonedService("Workspace").Filter.InvisibleWalls:GetChildren()) do
					local nm = tostring(v.Name):lower()
					if nm:find("invisible") or nm:find("invis") then
						pcall(function() v:Destroy() end)
					end
				end
			end
		end)
	end,
})

-- Hide toggle (replica o comportamento de enterrar e highlight)
ExploitsTab:CreateToggle({
	Name = "Hide",
	CurrentValue = false,
	Flag = "Hide",
	Callback = function(state)
		if state == true then
			pcall(function()
				if GET_HRP() then
					GET_HRP().Anchored = false
					for i = 1,10 do
						GET_HRP().CFrame = CFrame.new(ClonedService("Players").LocalPlayer.Character.HumanoidRootPart.Position) + Vector3.new(0,5,0)
						wait()
						GET_HRP().CFrame = CFrame.new(ClonedService("Players").LocalPlayer.Character.HumanoidRootPart.Position) + Vector3.new(0,-5,0)
					end
					GET_HRP().CFrame = CFrame.new(ClonedService("Players").LocalPlayer.Character.HumanoidRootPart.Position) + Vector3.new(0,-15,0)
					wait()
					GET_HRP().Anchored = true
					-- cria/posiciona HidePart caso não exista
					if not HidePart or not HidePart.Parent then
						HidePart = Instance.new("Part")
						HidePart.Size = Vector3.new(20,1000,20)
						HidePart.Anchored = true
						HidePart.Transparency = 1
						HidePart.Parent = ClonedService("Workspace")
					end
					HidePart.Position = ClonedService("Players").LocalPlayer.Character.HumanoidRootPart.Position + Vector3.new(0,-505,0)
					-- highlight de apoio (reusa HidePartHightLight se existir)
					if not HidePartHightLight or not HidePartHightLight.Parent then
						HidePartHightLight = Instance.new("Highlight")
						HidePartHightLight.Name = "HidePartHightLight"
						HidePartHightLight.FillColor = Color3.new(1,1,1)
						HidePartHightLight.OutlineColor = Color3.fromRGB(170,0,0)
						HidePartHightLight.FillTransparency = .8
						HidePartHightLight.OutlineTransparency = .8
					end
					HidePartHightLight.Adornee = HidePart
					HidePartHightLight.Parent = HidePart
				end
			end)
		else
			pcall(function()
				if GET_HRP() then
					GET_HRP().Anchored = false
					for i = 1,10 do
						GET_HRP().CFrame = CFrame.new(ClonedService("Players").LocalPlayer.Character.HumanoidRootPart.Position) + Vector3.new(0,5,0)
						wait()
						GET_HRP().CFrame = CFrame.new(ClonedService("Players").LocalPlayer.Character.HumanoidRootPart.Position) + Vector3.new(0,-5,0)
					end
					GET_HRP().CFrame = CFrame.new(ClonedService("Players").LocalPlayer.Character.HumanoidRootPart.Position) + Vector3.new(0,15,0)
					wait()
					GET_HRP().Anchored = false
					if HidePartHightLight then
						HidePartHightLight.Adornee = nil
						pcall(function() HidePartHightLight.Parent = nil end)
					end
				end
			end)
		end
	end,
})

-- Insta Open SupplyDrop Toggle (reaplica em loop enquanto ligado)
ExploitsTab:CreateToggle({
	Name = "Insta Open SupplyDrop",
	CurrentValue = false,
	Flag = "InstaOpenSupplyDrop",
	Callback = function(state)
		_G.InstaOpenSupplyDrop = state
		-- notifica mudança de estado
		Rayfield:Notify({
			Title = "InstaOpenSupplyDrop",
			Content = "State : "..tostring(_G.InstaOpenSupplyDrop),
			Duration = 1,
			Image = 4483362458
		})
	end,
})

-- Heartbeat que mantém o comportamento em loop (reaplica continuamente)
ClonedService("RunService").Heartbeat:Connect(function()
	if AllowRunService == true then
		if _G.InstaOpenSupplyDrop == true then
			pcall(function()
				local debris = ClonedService("Workspace"):FindFirstChild("Debris")
				if debris and debris:FindFirstChild("SupplyCrates") then
					local crateFolder = debris.SupplyCrates
					-- percorre todas as caixas (mantém compatibilidade se houver múltiplas)
					for _, box in pairs(crateFolder:GetChildren()) do
						if box.Name == "Box" and box:FindFirstChild("GUIPart") and box.GUIPart:FindFirstChild("ProximityPrompt") then
							-- remove atributos que bloqueiam a abertura (reaplica várias vezes em loop)
							for attrName,_ in pairs(box.GUIPart.ProximityPrompt:GetAttributes()) do
								pcall(function() box.GUIPart.ProximityPrompt:SetAttribute(tostring(attrName), false) end)
							end
							-- força UnlockValue repetidamente (se existir)
							if box:FindFirstChild("UnlockValue") and box.UnlockValue:IsA("ValueBase") then
								pcall(function() box.UnlockValue.Value = 100 end)
							end
						end
					end
				end
			end)
		end
	end
end)

-- === Novo Alternador: The Rake Highlight ===
ExploitsTab:CreateToggle({
	Name = "The Rake Highlight",
	CurrentValue = false,
	Flag = "RakeHighlight",
	Callback = function(state)
		_G.RakeHighlight = state

		if state == true then
			Rayfield:Notify({
				Title = "Rake ESP",
				Content = "Rake Highlight Ativado!",
				Duration = 2,
				Image = 4483362458
			})

			-- Função principal do loop de atualização
			task.spawn(function()
				while _G.RakeHighlight == true do
					pcall(function()
						for _,v in pairs(workspace:GetDescendants()) do
							if v:IsA("Model") and (v.Name == "Rake" or v.Name == "RDummy") then
								-- Cria Highlight se ainda não existir
								if not v:FindFirstChild("RakeHighlightESP") then
									local chams = Instance.new("Highlight")
									chams.Name = "RakeHighlightESP"
									chams.FillColor = Color3.fromRGB(255, 0, 0)
									chams.OutlineColor = Color3.fromRGB(255, 255, 255)
									chams.FillTransparency = 0.2
									chams.OutlineTransparency = 0.1
									chams.Adornee = v
									chams.Parent = v
									chams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
								end

								-- Cria ESP de texto se ainda não existir
								if not v:FindFirstChild("RakeTextBillboard") then
									local bill = Instance.new("BillboardGui")
									bill.Name = "RakeTextBillboard"
									bill.Size = UDim2.new(0, 100, 0, 30)
									bill.AlwaysOnTop = true
									bill.StudsOffset = Vector3.new(0, 3, 0)
									bill.Parent = v

									local txt = Instance.new("TextLabel")
									txt.Name = "Text"
									txt.BackgroundTransparency = 1
									txt.Size = UDim2.new(1, 0, 1, 0)
									txt.TextColor3 = Color3.fromRGB(255, 0, 0)
									txt.TextStrokeTransparency = 0
									txt.TextScaled = false
									txt.Font = Enum.Font.SourceSansBold
									txt.TextSize = 13  -- pequeno, conforme pedido
									txt.Text = "The Rake"
									txt.Parent = bill
								end

								-- Atualiza texto de distância
								local head = v:FindFirstChild("Head") or v:FindFirstChild("HumanoidRootPart")
								if head then
									local dist = math.floor((head.Position - game.Players.LocalPlayer.Character:WaitForChild("HumanoidRootPart").Position).Magnitude)
									local billboard = v:FindFirstChild("RakeTextBillboard")
									if billboard and billboard:FindFirstChild("Text") then
										billboard.Text.Text = "The Rake | Studs: " .. tostring(dist)
									end
								end
							end
						end
					end)
					task.wait(0.2) -- Atualiza a cada 0.2s
				end
			end)

		else
			Rayfield:Notify({
				Title = "Rake ESP",
				Content = "Rake Highlight Desativado!",
				Duration = 2,
				Image = 4483362458
			})

			-- Remove todos os ESPs e Highlights criados
			for _,v in pairs(workspace:GetDescendants()) do
				if v:IsA("Model") and (v.Name == "Rake" or v.Name == "RDummy") then
					if v:FindFirstChild("RakeHighlightESP") then
						v.RakeHighlightESP:Destroy()
					end
					if v:FindFirstChild("RakeTextBillboard") then
						v.RakeTextBillboard:Destroy()
					end
				end
			end
		end
	end
})

-- === Alternador: Flare Gun ESP (igual ao original) ===
ExploitsTab:CreateToggle({
	Name = "Flare Gun ESP",
	CurrentValue = false,
	Flag = "FlareGunESP",
	Callback = function(state)
		_G.FlareGunESP = state

		if state == true then
			Rayfield:Notify({
				Title = "Flare Gun ESP",
				Content = "Ativado",
				Duration = 1,
				Image = 4483362458
			})

			-- spawn loop para garantir que novas pickups recebam ESP
			task.spawn(function()
				while _G.FlareGunESP == true do
					pcall(function()
						-- procura por FlareGunPickUp no workspace (pode ser direto child ou múltiplos)
						for _, obj in pairs(workspace:GetDescendants()) do
							if obj.Name == "FlareGunPickUp" then
								-- marca com atributo (compatibilidade com lógicas existentes)
								if pcall(function() obj:SetAttribute then return true end) then
									pcall(function() obj:SetAttribute("FlareGunESP", true) end)
								end

								-- cria Highlight se não existir
								if not obj:FindFirstChild("FlareGunChams") then
									local FlareGunChams = Instance.new("Highlight")
									FlareGunChams.Name = "FlareGunChams"
									FlareGunChams.Parent = obj
									FlareGunChams.Adornee = obj
									-- estilo parecido com o original
									FlareGunChams.FillColor = Color3.fromRGB(255, 0, 0)
									FlareGunChams.FillTransparency = 0.3
									FlareGunChams.OutlineTransparency = 0.8
									FlareGunChams.OutlineColor = Color3.fromRGB(170,170,170)
									FlareGunChams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
								end

								-- cria BillboardGui + TextLabel pequeno se não existir
								if not obj:FindFirstChild("FlareGunBillboard") then
									local bill = Instance.new("BillboardGui")
									bill.Name = "FlareGunBillboard"
									bill.Adornee = obj
									bill.AlwaysOnTop = true
									-- pequeno como pediu
									bill.Size = UDim2.new(0, 100, 0, 20)
									bill.StudsOffset = Vector3.new(0, 2.2, 0)
									bill.Parent = obj

									local txt = Instance.new("TextLabel")
									txt.Name = "Text"
									txt.BackgroundTransparency = 1
									txt.Size = UDim2.new(1, 0, 1, 0)
									txt.Font = Enum.Font.SourceSansBold
									txt.TextSize = 14
									txt.TextScaled = false
									txt.TextColor3 = Color3.fromRGB(255, 0, 0)
									txt.TextStrokeTransparency = 0
									txt.Text = "Flare Gun"
									txt.Parent = bill
								end
							end
						end
					end)
					-- loop curto para responsividade mas sem travar
					task.wait(0.25)
				end
			end)

		else
			-- desativando: remove highlights e billboards criados, limpa atributos
			Rayfield:Notify({
				Title = "Flare Gun ESP",
				Content = "Desativado",
				Duration = 1,
				Image = 4483362458
			})

			pcall(function()
				for _, obj in pairs(workspace:GetDescendants()) do
					if obj.Name == "FlareGunPickUp" then
						-- remove highlight
						if obj:FindFirstChild("FlareGunChams") then
							pcall(function() obj.FlareGunChams:Destroy() end)
						end
						-- remove billboard
						if obj:FindFirstChild("FlareGunBillboard") then
							pcall(function() obj.FlareGunBillboard:Destroy() end)
						end
						-- limpa atributo (se existir)
						if pcall(function() return obj:GetAttribute and true end) then
							pcall(function() obj:SetAttribute("FlareGunESP", false) end)
						end
					end
				end
			end)
		end
	end,
})

-- === Alternador: Supply Drop ESP (igual ao original) ===
ClientTab:CreateToggle({
	Name = "Supply Drop ESP",
	CurrentValue = false,
	Flag = "SupplyDropESP",
	Callback = function(state)
		_G.SupplyDropESP = state

		if state == true then
			Rayfield:Notify({
				Title = "Supply Drop ESP",
				Content = "Ativado",
				Duration = 1,
				Image = 4483362458
			})

			-- loop que reaplica ESPs em todas as caixas e pega novas spawns
			task.spawn(function()
				while _G.SupplyDropESP == true do
					pcall(function()
						local debris = workspace:FindFirstChild("Debris")
						if debris and debris:FindFirstChild("SupplyCrates") then
							for _, box in pairs(debris.SupplyCrates:GetChildren()) do
								-- procura por objetos que representam caixa (ex: "Box")
								if box.Name == "Box" then
									-- marca atributo pra compatibilidade com lógicas existentes
									if pcall(function() return box.SetAttribute end) then
										pcall(function() box:SetAttribute("SupplyDropESP", true) end)
									end

									-- cria Highlight (chams) se ainda não existir
									if not box:FindFirstChild("SupplyDropChams") then
										local chams = Instance.new("Highlight")
										chams.Name = "SupplyDropChams"
										chams.Parent = box
										chams.Adornee = box
										chams.FillColor = Color3.fromRGB(251, 255, 0) -- amarelo-ish como original
										chams.FillTransparency = 0.0
										chams.OutlineTransparency = 0.0
										chams.OutlineColor = Color3.fromRGB(170,170,170)
										chams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
									end

									-- cria BillboardGui pequeno se ainda não existir
									if not box:FindFirstChild("SupplyDropBillboard") then
										local bill = Instance.new("BillboardGui")
										bill.Name = "SupplyDropBillboard"
										bill.Adornee = box
										bill.AlwaysOnTop = true
										bill.Size = UDim2.new(0, 110, 0, 18) -- pequeno
										bill.StudsOffset = Vector3.new(0, 2, 0)
										bill.Parent = box

										local txt = Instance.new("TextLabel")
										txt.Name = "Text"
										txt.BackgroundTransparency = 1
										txt.Size = UDim2.new(1, 0, 1, 0)
										txt.Font = Enum.Font.SourceSansBold
										txt.TextSize = 13
										txt.TextScaled = false
										txt.TextColor3 = Color3.fromRGB(255, 240, 50)
										txt.TextStrokeTransparency = 0
										txt.Text = "Supply Drop"
										txt.Parent = bill
									end
								end
							end
						end
					end)

					-- espera curta para responsividade sem travar
					task.wait(0.25)
				end
			end)

		else
			-- desativando: remove highlights, billboards e limpa atributos
			Rayfield:Notify({
				Title = "Supply Drop ESP",
				Content = "Desativado",
				Duration = 1,
				Image = 4483362458
			})

			pcall(function()
				local debris = workspace:FindFirstChild("Debris")
				if debris and debris:FindFirstChild("SupplyCrates") then
					for _, box in pairs(debris.SupplyCrates:GetChildren()) do
						if box.Name == "Box" then
							if box:FindFirstChild("SupplyDropChams") then
								pcall(function() box.SupplyDropChams:Destroy() end)
							end
							if box:FindFirstChild("SupplyDropBillboard") then
								pcall(function() box.SupplyDropBillboard:Destroy() end)
							end
							if pcall(function() return box.GetAttribute end) then
								pcall(function() box:SetAttribute("SupplyDropESP", false) end)
							end
						end
					end
				end
			end)
		end
	end,
})

-- === Alternador: Scrap ESP (igual ao original) ===
ClientTab:CreateToggle({
	Name = "Scrap ESP",
	CurrentValue = false,
	Flag = "ScrapESP",
	Callback = function(state)
		_G.ScrapESP = state

		if state == true then
			Rayfield:Notify({
				Title = "Scrap ESP",
				Content = "Ativado",
				Duration = 1,
				Image = 4483362458
			})

			-- loop que reaplica ESPs em todos os scraps e pega novas spawns
			task.spawn(function()
				while _G.ScrapESP == true do
					pcall(function()
						local filter = workspace:FindFirstChild("Filter")
						if filter and filter:FindFirstChild("ScrapSpawns") then
							for _, v in pairs(filter.ScrapSpawns:GetDescendants()) do
								-- procura por partes chamadas "Scrap"
								if v.Name == "Scrap" and (v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("Part")) then
									-- marca atributo para compatibilidade
									if pcall(function() return v.SetAttribute end) then
										pcall(function() v:SetAttribute("ScrapESP", true) end)
									end

									-- cria Highlight (chams) se ainda não existir
									if not v:FindFirstChild("ScrapChams") then
										local ScrapChams = Instance.new("Highlight")
										ScrapChams.Name = "ScrapChams"
										ScrapChams.Parent = v
										ScrapChams.Adornee = v
										ScrapChams.FillColor = Color3.fromRGB(77, 35, 1)
										ScrapChams.FillTransparency = 0
										ScrapChams.OutlineTransparency = 0
										ScrapChams.OutlineColor = Color3.fromRGB(170,170,170)
										ScrapChams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
									end

									-- cria/atualiza BillboardGui pequeno com pontos e level
									if not v:FindFirstChild("ScrapBillboard") then
										local bill = Instance.new("BillboardGui")
										bill.Name = "ScrapBillboard"
										bill.Adornee = v
										bill.AlwaysOnTop = true
										bill.Size = UDim2.new(0, 140, 0, 18) -- pequeno
										bill.StudsOffset = Vector3.new(0, 1.5, 0)
										bill.Parent = v

										local txt = Instance.new("TextLabel")
										txt.Name = "Text"
										txt.BackgroundTransparency = 1
										txt.Size = UDim2.new(1, 0, 1, 0)
										txt.Font = Enum.Font.SourceSansBold
										txt.TextSize = 13
										txt.TextScaled = false
										txt.TextColor3 = Color3.fromRGB(77, 35, 1)
										txt.TextStrokeTransparency = 0
										txt.Text = "Scrap"
										txt.Parent = bill
									end

									-- atualiza texto com Points e Level (se estiverem no parent)
									local parent = v.Parent
									local points, level = nil, nil
									pcall(function()
										if parent and parent:FindFirstChild("PointsVal") then points = parent.PointsVal.Value end
										if parent and parent:FindFirstChild("LevelVal") then level = parent.LevelVal.Value end
									end)

									local billGui = v:FindFirstChild("ScrapBillboard")
									if billGui and billGui:FindFirstChild("Text") then
										local label = billGui.Text
										local textStr = "Scrap"
										if points ~= nil and level ~= nil then
											textStr = "Scrap, Points " .. tostring(points) .. ", Level " .. tostring(level)
										elseif points ~= nil then
											textStr = "Scrap, Points " .. tostring(points)
										end
										label.Text = textStr
									end
								end
							end
						end
					end)
					-- pequeno delay para responsividade sem travar
					task.wait(0.25)
				end
			end)

		else
			-- desativando: remove highlights, billboards e limpa atributos
			Rayfield:Notify({
				Title = "Scrap ESP",
				Content = "Desativado",
				Duration = 1,
				Image = 4483362458
			})

			pcall(function()
				local filter = workspace:FindFirstChild("Filter")
				if filter and filter:FindFirstChild("ScrapSpawns") then
					for _, v in pairs(filter.ScrapSpawns:GetDescendants()) do
						if v.Name == "Scrap" then
							if v:FindFirstChild("ScrapChams") then
								pcall(function() v.ScrapChams:Destroy() end)
							end
							if v:FindFirstChild("ScrapBillboard") then
								pcall(function() v.ScrapBillboard:Destroy() end)
							end
							if pcall(function() return v.GetAttribute end) then
								pcall(function() v:SetAttribute("ScrapESP", false) end)
							end
						end
					end
				end
			end)
		end
	end,
})

-- === Alternador: Location ESP (igual ao original) ===
ClientTab:CreateToggle({
	Name = "Location ESP",
	CurrentValue = false,
	Flag = "LocationESP",
	Callback = function(state)
		_G.LocationESP = state

		-- Lista de locais fixos do mapa
		local Locations = {
			["Power_Station"] = {
				["Position"] = Vector3.new(-281.6848449707031, 21.50823974609375, -212.7472686767578),
				["hasESP"] = false,
			},
			["Safe_House"] = {
				["Position"] = Vector3.new(-363.491, 16.8744, 70.3037),
				["hasESP"] = false,
			},
			["Base_Camp"] = {
				["Position"] = Vector3.new(-70.7133, 17.6142, 209.0067),
				["hasESP"] = false,
			},
			["Shop"] = {
				["Position"] = Vector3.new(-25.1567, 17.2076, -258.362),
				["hasESP"] = false,
			}
		}

		if state == true then
			Rayfield:Notify({
				Title = "Location ESP",
				Content = "Ativado",
				Duration = 1,
				Image = 4483362458
			})

			-- Loop de atualização dos locais
			task.spawn(function()
				while _G.LocationESP == true do
					pcall(function()
						for name, data in pairs(Locations) do
							-- Cria BillboardGui se ainda não existir
							if not data.Billboard then
								local billboard = Instance.new("BillboardGui")
								billboard.Name = "LocationESP_"..name
								billboard.AlwaysOnTop = true
								billboard.Size = UDim2.new(0, 150, 0, 18)
								billboard.StudsOffset = Vector3.new(0, 2.5, 0)
								billboard.MaxDistance = 5000

								local label = Instance.new("TextLabel")
								label.BackgroundTransparency = 1
								label.Size = UDim2.new(1, 0, 1, 0)
								label.Font = Enum.Font.SourceSansBold
								label.TextSize = 13
								label.TextScaled = false
								label.TextColor3 = Color3.fromRGB(255, 136, 0)
								label.TextStrokeTransparency = 0
								label.Text = "[LOCATION] "..name
								label.Parent = billboard

								-- cria um objeto invisível no ponto fixo
								local marker = Instance.new("Part")
								marker.Anchored = true
								marker.CanCollide = false
								marker.Transparency = 1
								marker.Position = data.Position
								marker.Name = "LocationMarker_"..name
								marker.Parent = workspace
								billboard.Adornee = marker
								billboard.Parent = marker

								data.Billboard = billboard
								data.Marker = marker
								data.hasESP = true
							else
								-- Atualiza texto (opcionalmente pode mostrar distância)
								local player = game.Players.LocalPlayer
								if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
									local dist = math.floor((player.Character.HumanoidRootPart.Position - data.Position).Magnitude)
									data.Billboard.TextLabel.Text = "[LOCATION] "..name.." ("..tostring(dist).." studs)"
								end
							end
						end
					end)
					task.wait(0.25)
				end
			end)

		else
			-- Desativa ESPs e remove tudo
			Rayfield:Notify({
				Title = "Location ESP",
				Content = "Desativado",
				Duration = 1,
				Image = 4483362458
			})

			pcall(function()
				for _, obj in pairs(workspace:GetChildren()) do
					if string.find(obj.Name, "LocationMarker_") then
						pcall(function() obj:Destroy() end)
					end
				end
			end)
		end
	end,
})

-- === Alternador: Player ESP (igual ao original) ===
ClientTab:CreateToggle({
	Name = "Player ESP",
	CurrentValue = false,
	Flag = "PlayerESP",
	Callback = function(state)
		_G.PlayerESP = state

		if state == true then
			Rayfield:Notify({
				Title = "Player ESP",
				Content = "Ativado",
				Duration = 1,
				Image = 4483362458
			})

			-- loop contínuo para manter ESPs atualizados
			task.spawn(function()
				while _G.PlayerESP == true do
					pcall(function()
						for _, plr in pairs(game.Players:GetPlayers()) do
							local lp = game.Players.LocalPlayer
							if plr ~= lp and plr.Character and plr.Character:FindFirstChild("Head") then
								local char = plr.Character

								-- cria Highlight (chams) se ainda não existir
								if not char:FindFirstChild("PlayerChams") then
									local PlayerChams = Instance.new("Highlight")
									PlayerChams.Name = "PlayerChams"
									PlayerChams.Parent = char
									PlayerChams.Adornee = char
									PlayerChams.FillColor = Color3.fromRGB(0, 11, 170)
									PlayerChams.FillTransparency = 0.3
									PlayerChams.OutlineTransparency = 0.8
									PlayerChams.OutlineColor = Color3.fromRGB(170,170,170)
									PlayerChams.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
								end

								-- cria BillboardGui (nome e distância)
								if not char:FindFirstChild("PlayerBillboard") then
									local bill = Instance.new("BillboardGui")
									bill.Name = "PlayerBillboard"
									bill.Adornee = char:FindFirstChild("Head")
									bill.AlwaysOnTop = true
									bill.Size = UDim2.new(0, 200, 0, 16)
									bill.StudsOffset = Vector3.new(0, 2.5, 0)
									bill.Parent = char

									local txt = Instance.new("TextLabel")
									txt.Name = "Text"
									txt.BackgroundTransparency = 1
									txt.Size = UDim2.new(1, 0, 1, 0)
									txt.Font = Enum.Font.SourceSansBold
									txt.TextSize = 13
									txt.TextColor3 = Color3.fromRGB(0, 255, 34)
									txt.TextStrokeTransparency = 0
									txt.TextScaled = false
									txt.Text = plr.Name
									txt.Parent = bill
								end

								-- atualiza texto (nome + distância opcional)
								local head = char:FindFirstChild("Head")
								local root = char:FindFirstChild("HumanoidRootPart")
								local txtLabel = char:FindFirstChild("PlayerBillboard") and char.PlayerBillboard:FindFirstChild("Text")

								if head and root and txtLabel then
									local lpChar = lp.Character
									if lpChar and lpChar:FindFirstChild("HumanoidRootPart") then
										local dist = math.floor((lpChar.HumanoidRootPart.Position - root.Position).Magnitude)
										if _G.PlayerESPShowDistance == true and plr:FindFirstChild("DistanceTravelled") then
											txtLabel.Text = plr.Name.." [Distance Travelled : "..tostring(plr.DistanceTravelled.Value).."]"
										else
											txtLabel.Text = plr.Name.." ("..dist.." studs)"
										end
									end
								end
							end
						end
					end)
					task.wait(0.25)
				end
			end)

		else
			-- desativa ESPs (remove Highlights e Billboards)
			Rayfield:Notify({
				Title = "Player ESP",
				Content = "Desativado",
				Duration = 1,
				Image = 4483362458
			})

			pcall(function()
				for _, plr in pairs(game.Players:GetPlayers()) do
					local lp = game.Players.LocalPlayer
					if plr ~= lp and plr.Character then
						local char = plr.Character
						if char:FindFirstChild("PlayerChams") then
							pcall(function() char.PlayerChams:Destroy() end)
						end
						if char:FindFirstChild("PlayerBillboard") then
							pcall(function() char.PlayerBillboard:Destroy() end)
						end
					end
				end
			end)
		end
	end,
})

-- (Alternador extra usado em conjunto — igual ao original)
ClientTab:CreateToggle({
	Name = "Show Distance Travelled",
	CurrentValue = false,
	Flag = "ShowDistanceTravelled",
	Callback = function(state)
		_G.PlayerESPShowDistance = state
	end,
})

-- === Alternador: No Fall Damage (igual ao original) ===
PlayerTab:CreateToggle({
	Name = "No Fall Damage",
	CurrentValue = false,
	Flag = "NoFallDamage",
	Callback = function(state)
		_G.NoFallDamage = state

		if state == true then
			Rayfield:Notify({
				Title = "No Fall Damage",
				Content = "Ativado",
				Duration = 1,
				Image = 4483362458
			})

			task.spawn(function()
				while _G.NoFallDamage == true do
					pcall(function()
						local plr = game.Players.LocalPlayer
						local char = plr.Character or plr.CharacterAdded:Wait()
						local hum = char:FindFirstChildOfClass("Humanoid")
						if hum then
							-- Remove todas as conexões e eventos que causam dano por queda
							for _, v in pairs(getconnections(hum.StateChanged)) do
								if tostring(v.Function):find("Falling") or tostring(v.Function):find("Landed") then
									v:Disable()
								end
							end

							-- força o estado de queda a não causar dano
							hum.StateChanged:Connect(function(old, new)
								if new == Enum.HumanoidStateType.Freefall then
									hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
								end
							end)

							-- zera dano causado por eventos de servidor (caso existam)
							if char:FindFirstChild("FallDamage") then
								char.FallDamage:Destroy()
							end
						end
					end)
					task.wait(0.25)
				end
			end)

		else
			Rayfield:Notify({
				Title = "No Fall Damage",
				Content = "Desativado",
				Duration = 1,
				Image = 4483362458
			})

			-- reativa o comportamento padrão do Humanoid
			pcall(function()
				local plr = game.Players.LocalPlayer
				local char = plr.Character
				if char then
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hum then
						hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
					end
				end
			end)
		end
	end,
})

-- === Alternador: Inf Stamina (igual ao original) ===
PlayerTab:CreateToggle({
	Name = "Inf Stamina",
	CurrentValue = false,
	Flag = "InfStamina",
	Callback = function(state)
		_G.InfStamina = state

		if state == true then
			Rayfield:Notify({
				Title = "Infinite Stamina",
				Content = "Ativado",
				Duration = 1,
				Image = 4483362458
			})

			task.spawn(function()
				while _G.InfStamina == true do
					pcall(function()
						local plr = game.Players.LocalPlayer
						local playerScripts = plr:FindFirstChild("PlayerScripts")
						if playerScripts then
							-- tenta localizar o script de energia original
							for _, module in pairs(playerScripts:GetDescendants()) do
								if module:IsA("ModuleScript") and module.Name:lower():find("stamina") then
									-- se houver variável de stamina, força o valor máximo
									for _, v in pairs(getgc(true)) do
										if typeof(v) == "table" and rawget(v, "Stamina") then
											v.Stamina = 100
											v.MaxStamina = 100
										end
									end
								end
							end
						end

						-- tenta localizar valores diretos de stamina no PlayerGui
						local gui = plr:FindFirstChild("PlayerGui")
						if gui then
							for _, obj in pairs(gui:GetDescendants()) do
								if obj:IsA("NumberValue") and obj.Name:lower():find("stamina") then
									obj.Value = obj.MaxValue or 100
								end
							end
						end
					end)
					task.wait(0.1)
				end
			end)

		else
			Rayfield:Notify({
				Title = "Infinite Stamina",
				Content = "Desativado",
				Duration = 1,
				Image = 4483362458
			})
		end
	end,
})

-- === Slider + Toggle: WalkSpeed (igual ao original, máx 30) ===
local WalkSpeedValue = 16 -- valor padrão Roblox

PlayerTab:CreateSlider({
	Name = "WalkSpeed",
	Range = {16, 30},
	Increment = 1,
	Suffix = "Speed",
	CurrentValue = 16,
	Flag = "WalkSpeedSlider",
	Callback = function(value)
		WalkSpeedValue = value
		if _G.WalkSpeedEnabled then
			local plr = game.Players.LocalPlayer
			local char = plr.Character or plr.CharacterAdded:Wait()
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = WalkSpeedValue
			end
		end
	end,
})

PlayerTab:CreateToggle({
	Name = "WalkSpeed Toggle",
	CurrentValue = false,
	Flag = "WalkSpeedToggle",
	Callback = function(state)
		_G.WalkSpeedEnabled = state

		if state == true then
			Rayfield:Notify({
				Title = "WalkSpeed",
				Content = "Ativado (Máx 30)",
				Duration = 1,
				Image = 4483362458
			})

			task.spawn(function()
				while _G.WalkSpeedEnabled == true do
					pcall(function()
						local plr = game.Players.LocalPlayer
						local char = plr.Character or plr.CharacterAdded:Wait()
						local hum = char:FindFirstChildOfClass("Humanoid")
						if hum then
							hum.WalkSpeed = math.clamp(WalkSpeedValue, 16, 30)
						end
					end)
					task.wait(0.1)
				end
			end)

		else
			Rayfield:Notify({
				Title = "WalkSpeed",
				Content = "Desativado",
				Duration = 1,
				Image = 4483362458
			})

			-- retorna para a velocidade padrão
			pcall(function()
				local plr = game.Players.LocalPlayer
				local char = plr.Character
				if char then
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hum then
						hum.WalkSpeed = 16
					end
				end
			end)
		end
	end,
})